MONGODB_URI=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=
GOOGLE_YOUTUBE_API_KEY=
REDIS_URL=
API_SECRET=
JWT_SECRET=
ALLOWED_ORIGINS=
NODE_ENV=development
GEMINI_API_KEY=
# Mailgun — email delivery
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Food Center <noreply@yourdomain.com>
MAILGUN_REGION=us
# Admin email address — receives "want to be featured" creator inquiries
ADMIN_EMAIL=admin@yourdomain.com
# Public URL of the frontend (used in email links and Stripe redirects)
CLIENT_URL=http://localhost:5173

# ── Stripe (freemium billing) ─────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys and your product/price setup
STRIPE_SECRET_KEY=sk_test_...
# Price ID for the Pro monthly subscription (create in Stripe Dashboard → Products)
STRIPE_PRO_PRICE_ID=price_...
# Price ID for the one-time 10-credit pack (create as a one-time price in Stripe Dashboard)
STRIPE_CREDITS_PRICE_ID=price_...
# Webhook signing secret — get from Stripe Dashboard → Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_...
